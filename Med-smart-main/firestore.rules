rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function isAdmin() {
      return signedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    function validPublicInquiry(data) {
      return data.name is string && data.name.size() >= 2 && data.name.size() <= 120 &&
        data.phone is string && data.phone.size() >= 7 && data.phone.size() <= 30 &&
        data.email is string && data.email.size() <= 160 &&
        data.ticketId is string && data.ticketId.size() <= 80 &&
        data.status == 'new' &&
        data.message is string && data.message.size() <= 5000;
    }

    match /users/{uid} {
      allow get: if isOwner(uid) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(uid) && request.resource.data.uid == request.auth.uid && request.resource.data.role == 'client';
      allow update: if isOwner(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName','photoURL','phoneNumber','language','updatedAt']);
      allow delete: if false;
    }

    match /gcc_dynamic_media/{mediaId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /inquiries/{inquiryId} {
      allow create: if validPublicInquiry(request.resource.data);
      allow read, update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
